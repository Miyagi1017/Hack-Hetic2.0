# GEMINI_API_KEY: clé Google AI Studio / Gemini pour le concierge IA.
# Optionnelle : sans clé, l'assistant utilise des réponses locales de démonstration.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: port du serveur Express de développement (3000 par défaut). Inutile sur Vercel.
PORT=3000

# DISABLE_HMR: passez à "true" pour désactiver le HMR de Vite en local.
DISABLE_HMR="false"
